# Copy to .env.local. Every variable is optional; the site runs with none set
# (mock content, no payments, no analytics). See docs/technical-handover.md.

# ---- Site --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://haart.org.au

# ---- Sanity (content) --------------------------------------------------
# Create the project at sanity.io/manage and apply for the non-profit plan.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Viewer token (only needed if the dataset is private)
SANITY_API_READ_TOKEN=
# Editor token used by the events cron, form submissions and the import script
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that revalidates pages on publish
SANITY_REVALIDATE_SECRET=

# ---- PetRescue (animal listings) ---------------------------------------
# Request an API token as PetRescue group 10046 via members@petrescue.org.au.
# Without it the site serves Sanity animal documents (or mock data in dev).
PETRESCUE_API_TOKEN=
PETRESCUE_GROUP_ID=10046
PETRESCUE_API_BASE=https://www.petrescue.com.au/api

# ---- Events (Facebook iCal -> Sanity, polled by cron) ------------------
# A page admin's personal "upcoming events" iCal export URL from Facebook.
# Format: https://www.facebook.com/events/ical/upcoming/?uid=...&key=...
FACEBOOK_EVENTS_ICAL_URL=
# Any long random string; the cron caller sends it as Authorization: Bearer
CRON_SECRET=

# ---- Static map tiles for event cards ----------------------------------
MAP_STATIC_PROVIDER=geoapify
MAP_STATIC_API_KEY=

# ---- Analytics (Plausible, cookieless) ---------------------------------

# ---- Form delivery -----------------------------------------------------

# ---------------------------------------------------------------------------
# Deliberately absent, and must stay absent
#
# This is an unofficial concept build. It takes no money, captures no enquiry
# and measures no visitor, so there is nothing here for a payment provider, a
# transactional mail sender or an analytics host. If you find yourself adding
# one of these back, check docs/constraints.md first — the retrofit that
# removed them was a hard requirement, not a simplification.
#
#   STRIPE_* / SQUARE_* / PAYPAL_*   no payments, ever
#   RESEND_API_KEY / FORMS_*         no forms, so nothing to deliver
#   NEXT_PUBLIC_PLAUSIBLE_*          no analytics of someone else's visitors
# ---------------------------------------------------------------------------
